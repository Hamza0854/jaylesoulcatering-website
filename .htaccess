# =========================================================
#  Chef Jay LeSoul Catering — Apache / LiteSpeed (Hostinger)
# =========================================================
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

AddType video/mp4  .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType image/avif .avif

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- 1. Private code / data never leaves the server ----
  RewriteRule ^(app|storage)(/|$) - [F,L]
  RewriteRule ^router\.php$ - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|md|log|ini|lock|bak|sh)$ - [F,L]

  # ---- 2. Old URLs → clean URLs (301, query string kept) ----
  #   /index.html  → /          /admin/index.php → /admin/
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index(?:\.html|\.php)?[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  #   /contact.html → /contact   /account/login.php → /account/login
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.(?:html|php)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # customer accounts were removed: send old links to the review form
  RewriteRule ^account(/.*)?$ /review [R=301,L]

  # ---- 3. Drop trailing slash on anything that isn't a folder ----
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ---- 4. Serve clean URLs from the .html / .php file ----
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Browser caching for media (CSS/JS use ?v= versions) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4  "access plus 30 days"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
